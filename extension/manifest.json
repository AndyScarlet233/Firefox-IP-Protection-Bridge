{
  "manifest_version": 3,
  "name": "Firefox IP 保护桥接（非官方）",
  "short_name": "火狐 VPN",
  "version": "1.0.3",
  "description": "通过本地桥接在 Chrome 中使用 Firefox IP 保护，并提供白名单/黑名单路由、按路由生效的 DNS 防护、WebRTC 防泄漏、区域隐私保护和可移动安装。",
  "key": "",
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "activeTab",
    "privacy",
    "declarativeNetRequestWithHostAccess",
    "contentSettings",
    "scripting",
    "management",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "火狐 VPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "region-shield-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "region-shield-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}